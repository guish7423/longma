{
  "$schema": "https://raw.githubusercontent.com/nicedayzhu/tauri-v2-schema/refs/heads/main/tauri.conf.json",
  "productName": "LongMa",
  "version": "0.1.0",
  "identifier": "com.longma.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LongMa",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png"
    ]
  }
}
